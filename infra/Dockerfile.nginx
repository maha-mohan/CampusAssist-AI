# Builds both React apps and serves them with Nginx.
FROM node:20-alpine AS widget
WORKDIR /w
COPY frontend/widget/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend/widget/ .
RUN npm run build

FROM node:20-alpine AS admin
WORKDIR /a
COPY frontend/admin/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend/admin/ .
RUN npm run build

FROM nginx:1.27-alpine
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=widget /w/dist/ /usr/share/nginx/html/widget/
COPY --from=admin /a/dist/ /usr/share/nginx/html/admin/
COPY demo/ /usr/share/nginx/html/demo/
EXPOSE 80
