# ---------- App ----------
APP_NAME="College AI Help Desk"
COLLEGE_NAME="ABC Engineering College"
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://www.yourcollege.edu
CURRENT_ACADEMIC_YEAR=2026-27

# ---------- Security (CHANGE IN PRODUCTION) ----------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
FIRST_ADMIN_EMAIL=admin@college.edu
FIRST_ADMIN_PASSWORD=Admin@12345

# ---------- Database / Redis ----------
DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5432/helpdesk
REDIS_URL=redis://localhost:6379/0

# ---------- LLM ----------
# Leave OPENAI_API_KEY empty (or LLM_PROVIDER=mock) to run fully offline with the mock provider.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# To use Google Gemini instead (OpenAI-compatible endpoint), set your Gemini key above and:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CHAT_MODEL=gemini-3.5-flash-lite
# EMBEDDING_MODEL=gemini-embedding-001   # keep EMBEDDING_DIM=1536
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------- RAG tuning ----------
MIN_RELEVANCE_SCORE=0.30
FAQ_MATCH_THRESHOLD=0.86
RETRIEVAL_TOP_K=5

# ---------- Limits & retention ----------
RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=25
CHAT_RETENTION_DAYS=365

# ---------- Email alerts (optional) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=helpdesk@college.edu

# ---------- Monitoring (optional) ----------
SENTRY_DSN=
